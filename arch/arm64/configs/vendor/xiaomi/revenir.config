# REVENIR additions on top of the LineageOS sm8150 configs
# (vendor/sm8150-perf_defconfig + vendor/xiaomi/sm8150-common.config +
#  vendor/xiaomi/cepheus.config)

# Version string
CONFIG_LOCALVERSION="-REVENIR"
# CONFIG_LOCALVERSION_AUTO is not set

# KernelSU-Next legacy with manual hooks
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# Uncompressed Image with the base dtbs appended (Image-dtb), like the
# LineageOS and crDroid boot images. Flashed with AnyKernel3.
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_IMG_DTB=y
